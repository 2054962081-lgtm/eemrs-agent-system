{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-consultation evaluation case",
  "type": "object",
  "required": ["caseId", "caseType", "mode", "title", "scoring", "hardFailRules"],
  "properties": {
    "caseId": { "type": "string" },
    "caseType": {
      "type": "string",
      "enum": [
        "quick_common",
        "quick_red_flag",
        "deep_structured",
        "anti_misleading",
        "special_population",
        "record_generation"
      ]
    },
    "mode": { "type": "string", "enum": ["quick", "deep"] },
    "title": { "type": "string" },
    "patientProfile": {
      "type": "object",
      "properties": {
        "age": { "type": ["integer", "null"] },
        "gender": { "type": "string" },
        "specialPopulation": { "type": "string" },
        "chronicDisease": { "type": "string" }
      },
      "additionalProperties": true
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant", "system"] },
          "content": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant", "system"] },
          "content": { "type": "string" }
        }
      }
    },
    "consultationConclusion": { "type": "string" },
    "expected": { "type": "object", "additionalProperties": true },
    "expectedRecord": { "type": "object", "additionalProperties": true },
    "scoring": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "hardFailRules": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "caseType": { "const": "record_generation" } } },
      "then": { "required": ["history", "consultationConclusion", "expectedRecord"] },
      "else": { "required": ["patientProfile", "turns", "expected"] }
    }
  ],
  "additionalProperties": false
}
